# Sarathi -- Yantra, Setu, Samay and Prahari (and Dvara, Sparsh, Vaani, Smritikosh) in one image.
#
# Not built by hand: `sarathi image` puts a clean copy of each project's
# committed code beside this file and builds from there. The context is
#
#   yantra/  setu/  samay/  dvara/  sparsh/  prahari/  vaani/  smritikosh/ (the
#   last five maybe empty)  Containerfile
#
# ONE IMAGE, SEVERAL CONTAINERS. The projects call each other as programs
# -- the page runs `setu run gmail:mine` and `samay mcp`, the clock runs
# `yantra --json` -- so every program has to be in every container. Each
# project keeps its own environment under /opt, as on a desktop, so their
# dependencies never have to agree; /usr/local/bin holds one link to each.
#
# The image carries code only. Keys, sign-ins, schedules and memories are
# mounted at run time by the units `sarathi up` writes.

FROM python:3.12-slim

# What the programs need from the system, beyond Python:
#
#   bubblewrap  Setu's wall around a connector: no network, nothing of
#               yours to read. Without it a connector still holds no key,
#               but it is not walled off, and Setu's card says so.
#   a browser   Amazon and X are signed in to in a browser, and their
#               tools drive one. GOOGLE CHROME, at /usr/bin/google-chrome,
#               where a desktop has it: Setu records which browser wrote a
#               profile and opens it with that one, and Chrome refuses a
#               profile written by a newer version of itself, so the same
#               browser at the same path opens the profiles you already
#               have. Google ships it for amd64 only; elsewhere Debian's
#               Chromium is installed instead (profiles from a desktop's
#               Chrome may then need signing in to again).
#   xvfb        a screen nobody looks at, for a site whose rules say a
#               real window (X): headless is what those sites detect.
#   fonts       so a page has its letters, and a screenshot is readable.
#   ffmpeg      a voice note from Telegram or the page, made the WAV a
#               local model that hears takes (Dvara's heard.py); and an
#               answer read aloud, made the OGG Telegram plays as a voice
#               note (Dvara's spoken.py; Piper, below).
#
# HOST_BROWSER is this machine's Chrome version (`sarathi image` passes it).
# A new one re-runs this step: a cached layer would otherwise keep the
# Chrome of the first build, older than the one that signed the profiles.
ARG HOST_BROWSER=
RUN echo "this machine's browser: ${HOST_BROWSER:-none}" \
 && apt-get update \
 && apt-get install -y --no-install-recommends bubblewrap xvfb xauth \
      ca-certificates curl gnupg fonts-liberation fonts-noto-color-emoji ffmpeg \
 && if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      curl -fsSL https://dl.google.com/linux/linux_signing_key.pub \
        | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg && \
      echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] https://dl.google.com/linux/chrome/deb/ stable main" \
        > /etc/apt/sources.list.d/google-chrome.list && \
      apt-get update && apt-get install -y --no-install-recommends google-chrome-stable && \
      ln -s /usr/bin/google-chrome /usr/local/bin/sarathi-browser; \
    else \
      apt-get install -y --no-install-recommends chromium && \
      ln -s /usr/bin/chromium /usr/local/bin/sarathi-browser; \
    fi \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p -m 1777 /tmp/.X11-unix
# adb, for a phone reached over Wi-Fi (Sparsh, below). Wireless
# debugging (`adb pair`) needs adb 30 or newer. Google's platform-tools
# where Google ships them (amd64), the newest; elsewhere Debian's, which
# in trixie is 34 and pairs too.
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
 && if [ "$(dpkg --print-architecture)" = amd64 ]; then \
      curl -fsSL -o /tmp/pt.zip \
        https://dl.google.com/android/repository/platform-tools-latest-linux.zip && \
      unzip -q /tmp/pt.zip -d /opt && rm /tmp/pt.zip && \
      ln -s /opt/platform-tools/adb /usr/local/bin/adb; \
    else \
      apt-get install -y --no-install-recommends adb; \
    fi \
 && rm -rf /var/lib/apt/lists/*

# Yantra's browser tools use the browser above, not one Playwright would
# download: there is none in the image, and a real browser is a normal
# client to a site, where Playwright's own build announces itself.
ENV YANTRA_BROWSER_EXECUTABLE=/usr/local/bin/sarathi-browser

RUN pip install --no-cache-dir uv
# Copies, not hard links into uv's cache (which is not in the image), and
# the Python this image already has.
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never UV_NO_CACHE=1

# Voices, for answers read aloud (Dvara's spoken.py): Piper, a small
# text-to-speech model that runs on a CPU, in an environment of its own,
# and a voice file (about 60 MB each) where Dvara looks for them. Nothing
# is sent anywhere to be spoken. PIPER_VOICES is `[dvara] voices` in
# sarathi.toml (`sarathi image` passes it): names from
# https://huggingface.co/rhasspy/piper-voices, and an answer is read in a
# voice for its language when one is here. Empty: answers stay words.
ARG PIPER_VOICES="en_US-lessac-medium"
RUN uv venv -q /opt/piper && uv pip install -q --python /opt/piper/bin/python piper-tts==1.3.0 \
 && ln -s /opt/piper/bin/piper /usr/local/bin/piper \
 && mkdir -p /usr/share/piper/voices \
 && for v in $PIPER_VOICES; do \
      loc="${v%%-*}"; rest="${v#*-}"; who="${rest%-*}"; q="${rest##*-}"; \
      for f in "$v.onnx" "$v.onnx.json"; do \
        curl -fsSL -o "/usr/share/piper/voices/$f" \
          "https://huggingface.co/rhasspy/piper-voices/resolve/v1.0.0/${loc%%_*}/$loc/$who/$q/$f"; \
      done; \
    done

# Least-changing first, so a change to Samay does not reinstall Yantra.
# The browse extra is Playwright's Python side: what drives the browser.
COPY yantra/pyproject.toml yantra/uv.lock /opt/yantra/
RUN cd /opt/yantra && uv sync --frozen --no-dev --extra web --extra browse --no-install-project
COPY yantra/ /opt/yantra/
RUN cd /opt/yantra && uv sync --frozen --no-dev --extra web --extra browse

COPY setu/ /opt/setu/
RUN cd /opt/setu && uv sync --frozen --no-dev --all-packages

COPY samay/ /opt/samay/
RUN cd /opt/samay && uv sync --frozen --no-dev

RUN ln -s /opt/yantra/.venv/bin/yantra /opt/setu/.venv/bin/setu \
          /opt/samay/.venv/bin/samay /usr/local/bin/

# Prahari, the watch, when its checkout was there to copy. No
# dependencies of its own, like Samay: every look it makes is
# `yantra --call`, the Yantra above.
COPY prahari/ /opt/prahari/
RUN if [ -f /opt/prahari/pyproject.toml ]; then \
      cd /opt/prahari && uv sync --frozen --no-dev && \
      ln -s /opt/prahari/.venv/bin/prahari /usr/local/bin/; \
    fi

# Vaani, a voice puck's listener, when its checkout was there to copy.
# ESPHome's own client, and the voices extra (sherpa-onnx, CPU) that tells
# who is speaking; its model is fetched to this computer (`vaani voices
# fetch`) and mounted. Whisper and Piper are this computer's, reached at
# host.containers.internal.
COPY vaani/ /opt/vaani/
RUN if [ -f /opt/vaani/pyproject.toml ]; then \
      cd /opt/vaani && uv sync --frozen --no-dev --extra voices && \
      ln -s /opt/vaani/.venv/bin/vaani /usr/local/bin/; \
    fi

# dvara, the door, when its checkout was there to copy (an empty folder
# otherwise). It runs against the Yantra above, as on a desktop -- with
# the browse extra, or an agent behind the door is offered Amazon's tools
# and every one fails for want of Playwright.
COPY dvara/ /opt/dvara/
RUN if [ -f /opt/dvara/pyproject.toml ]; then \
      cd /opt/dvara && uv sync --frozen --no-dev --extra http --extra browse && \
      ln -s /opt/dvara/.venv/bin/dvara /usr/local/bin/; \
    fi

# Sparsh, the phone, when its checkout was there to copy. No dependencies
# of its own: it talks to the phone through the adb above.
COPY sparsh/ /opt/sparsh/
RUN if [ -f /opt/sparsh/pyproject.toml ]; then \
      cd /opt/sparsh && uv sync --frozen --no-dev && \
      ln -s /opt/sparsh/.venv/bin/sparsh /usr/local/bin/; \
    fi

# Smritikosh, the memory server, when `sarathi smritikosh` set one up (an
# empty folder otherwise): its server runs from this image as a container
# of its own, and Yantra's and Dvara's containers start `smritikosh-mcp`,
# the small program that reaches it. The mcp extra is that program.
COPY smritikosh/ /opt/smritikosh/
RUN if [ -f /opt/smritikosh/pyproject.toml ]; then \
      cd /opt/smritikosh && uv sync --no-dev --extra mcp && \
      ln -s /opt/smritikosh/.venv/bin/smritikosh-mcp /usr/local/bin/; \
    fi

# A pipe, not a terminal: without this, `podman logs` stays empty until
# the process exits.
ENV PYTHONUNBUFFERED=1
